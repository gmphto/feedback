{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && tsx --test test/*.test.ts && pnpm test:integration",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate-main.ts",
    "test:integration": "tsx --test test/integration/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "fastify": "^5.12.1",
    "kysely": "0.29.5",
    "openid-client": "6.8.8",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
